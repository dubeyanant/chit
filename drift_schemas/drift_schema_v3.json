          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chits\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"local_day\" INTEGER NOT NULL, \"body\" TEXT NULL, \"audio_path\" TEXT NULL, \"audio_ms\" INTEGER NULL, \"weather\" TEXT NULL, \"lat\" REAL NULL, \"lon\" REAL NULL, \"motion\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (body IS NOT NULL OR audio_path IS NOT NULL), CHECK (body IS NULL OR length(trim(body)) > 0), CHECK ((audio_path IS NULL) = (audio_ms IS NULL)), CHECK ((lat IS NULL) = (lon IS NULL)));"
